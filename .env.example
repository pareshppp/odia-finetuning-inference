# =============================================================================
# Secrets — the ONLY values that belong in .env.
# Copy this file to .env and fill in. Every other (non-secret) parameter
# (model id, hyperparameters, paths, workspace names, …) lives in config.py.
# =============================================================================
HF_TOKEN=hf_your_token_here
COMET_API_KEY=                 # optional but recommended — enables Comet metrics logging
OPIK_API_KEY=                  # optional — enables Opik LLM-trace decoration on sanity rollouts
